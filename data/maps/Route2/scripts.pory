raw `
Route2_MapScripts::
	.byte 0

Route2_EventScript_RouteSign::
	msgbox Route2_Text_RouteSign, MSGBOX_SIGN
	end

Route2_EventScript_DiglettsCaveSign::
	msgbox Route2_Text_DiglettsCave, MSGBOX_SIGN
	end
`
script Route2_EventScript_Police {
	lock
	faceplayer
	msgbox(format("This ain't something a kid like you should see."))
	release
	end
}